{
  "name": "foodmind-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-sites.mjs && node scripts/check-bundle.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "api:snapshot": "node scripts/snapshot-api.mjs",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/check-api.mjs",
    "api:coverage": "node scripts/check-api-coverage.mjs",
    "security:check": "node scripts/check-security.mjs",
    "bundle:check": "node scripts/check-bundle.mjs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config playwright.real.config.ts",
    "validate": "npm run api:check && npm run api:coverage && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "preview": "vite preview"
  },
  "engines": {
    "node": "24.16.x"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@tanstack/react-query": "^5.101.4",
    "@types/leaflet": "^1.9.22",
    "@vercel/functions": "^3.9.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.27.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.83.0",
    "react-router-dom": "7.18.2",
    "recharts": "^3.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/recharts": "^1.8.29",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "minimatch": "10.2.6"
    },
    "brace-expansion": "5.0.9",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18"
  }
}
